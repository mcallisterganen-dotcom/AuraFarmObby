{
  "name": "AuraFarmObby",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$className": "Folder",
        "ObbyConfig": {
          "$path": "src/shared/ObbyConfig.luau"
        },
        "CosmeticsCatalog": {
          "$path": "src/shared/CosmeticsCatalog.luau"
        },
        "Achievements": {
          "$path": "src/shared/Achievements.luau"
        },
        "Remotes": {
          "$path": "src/shared/Remotes.luau"
        },
        "RNG": {
          "$path": "src/shared/RNG.luau"
        },
        "Hello": {
          "$path": "src/shared/Hello.luau"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "ObbyServer": {
        "$path": "src/server/ObbyServer.server.luau"
      },
      "StageBuilder": {
        "$path": "src/server/StageBuilder.luau"
      },
      "PlayerData": {
        "$path": "src/server/PlayerData.luau"
      },
      "TrailService": {
        "$path": "src/server/TrailService.luau"
      },
      "HelloServer": {
        "$path": "src/server/HelloServer.server.luau"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ObbyClient": {
          "$path": "src/client/ObbyClient.client.luau"
        },
        "HelloClient": {
          "$path": "src/client/HelloClient.client.luau"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$className": "Lighting"
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
