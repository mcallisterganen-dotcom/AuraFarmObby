corner(weatherChip, 8)

-- Buttons
local btnCol = Instance.new("Frame")
btnCol.Name = "Buttons"
btnCol.AnchorPoint = Vector2.new(1, 0.5)
btnCol.Position = UDim2.new(1, -16, 0.5, 0)
btnCol.Size = UDim2.new(0, 120, 0, 280)
