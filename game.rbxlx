			<Item class="ModuleScript" referent="35">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Locomotion layer that REPLACES the default Animate LocalScript behavior
-- so run/walk look correct and don't fight stock animate.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnimationConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AnimationConfig"))

local AnimationSystem = {}
AnimationSystem.__index = AnimationSystem

local function loadTrack(animator: Animator, id: string, priority: Enum.AnimationPriority, looped: boolean): AnimationTrack?
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if not ok or not track then
		warn("[AnimationSystem] Failed to load", id, track)
		return nil
	end
	track.Priority = priority
	track.Looped = looped
	return track
end

function AnimationSystem.new(character: Model, humanoid: Humanoid, hrp: BasePart)
	local self = setmetatable({}, AnimationSystem)
	self.character = character
	self.humanoid = humanoid
	self.hrp = hrp
	self._destroyed = false
	self._tracks = {} :: { [string]: AnimationTrack }
	self._current = nil :: string?
	self._emoteTrack = nil :: AnimationTrack?

	-- Mute default Animate so we own locomotion
	local animate = character:FindFirstChild("Animate")
	if animate and animate:IsA("LocalScript") then
		animate.Disabled = true
	elseif animate then
		-- ModuleScript / Script variants
		pcall(function()
			(animate :: any).Disabled = true
		end)
	end
	-- Stop any leftover tracks
	for _, t in humanoid:GetPlayingAnimationTracks() do
		t:Stop(0)
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	self.animator = animator

	local ids = AnimationConfig.Ids
	local pri = AnimationConfig.Priorities
	self._tracks.Idle = loadTrack(animator, ids.Idle, pri.Idle, true)
	self._tracks.Walk = loadTrack(animator, ids.Walk, pri.Walk, true)
	self._tracks.Run = loadTrack(animator, ids.Run, pri.Run, true)
	self._tracks.Jump = loadTrack(animator, ids.Jump, pri.Jump, false)
	self._tracks.Fall = loadTrack(animator, ids.Fall, pri.Fall, true)

	self._emotes = {}
	for _, name in AnimationConfig.EmoteList do
		local id = ids[name]
		if id then
			self._emotes[name] = loadTrack(animator, id, pri.Emote, false)
		end
	end

	-- Start idle
	self:_play("Idle", 0.2)

	self._stateConn = humanoid.StateChanged:Connect(function(_, new)
		if self._destroyed then
			return
		end
		if new == Enum.HumanoidStateType.Jumping then
			self:_play("Jump", 0.05)
		elseif new == Enum.HumanoidStateType.Freefall then
			self:_play("Fall", 0.1)
		end
	end)

	self._hb = RunService.RenderStepped:Connect(function()
		if self._destroyed then
			return
		end
		self:_tick()
	end)

	return self
end

function AnimationSystem:_play(name: string, fade: number?)
	if self._current == name and name ~= "Jump" then
		return
	end
	local track = self._tracks[name]
	if not track then
		return
	end
	local fadeTime = fade or AnimationConfig.FadeTime
	if self._current and self._tracks[self._current] and self._current ~= name then
		self._tracks[self._current]:Stop(fadeTime)
	end
	track:Play(fadeTime)
	self._current = name
end

function AnimationSystem:_tick()
	if self._emoteTrack and self._emoteTrack.IsPlaying then
		return
	end
	local hum = self.humanoid
	local state = hum:GetState()
	if state == Enum.HumanoidStateType.Jumping then
		return
	end
	if state == Enum.HumanoidStateType.Freefall then
		if self._current ~= "Fall" then
			self:_play("Fall", 0.08)
		end
		return
	end
	if state == Enum.HumanoidStateType.Climbing then
		return
	end

	local speed = hum.MoveDirection.Magnitude * hum.WalkSpeed
	-- also use assembly velocity for slope/air remnants
	local hrp = self.hrp
	if hrp then
		local v = hrp.AssemblyLinearVelocity
		local planar = Vector3.new(v.X, 0, v.Z).Magnitude
		speed = math.max(speed, planar)
	end

	if speed < AnimationConfig.WalkSpeedThreshold then
		self:_play("Idle", 0.15)
	elseif hum.WalkSpeed >= AnimationConfig.RunSpeedThreshold or speed >= AnimationConfig.RunSpeedThreshold then
		self:_play("Run", 0.1)
		local run = self._tracks.Run
		if run then
			run:AdjustSpeed(math.clamp(speed / 20, 0.85, 1.35))
		end
	else
		self:_play("Walk", 0.1)
		local walk = self._tracks.Walk
		if walk then
			walk:AdjustSpeed(math.clamp(speed / 12, 0.7, 1.4))
		end
	end
end

function AnimationSystem:PlayEmote(name: string): boolean
	if name == "Victory" then
		name = "Cheer"
	end
	local track = self._emotes[name]
	if not track then
		return false
	end
	if self._emoteTrack and self._emoteTrack.IsPlaying then
		self._emoteTrack:Stop(0.1)
	end
	-- pause locomotion
	if self._current and self._tracks[self._current] then
		self._tracks[self._current]:Stop(0.1)
	end
	self._current = nil
	track:Play(0.1)
	self._emoteTrack = track
	track.Stopped:Once(function()
		if self._emoteTrack == track then
			self._emoteTrack = nil
		end
	end)
	return true
end

function AnimationSystem:PlayNextEmote(): string?
	self._emoteIndex = (self._emoteIndex or 0) + 1
	local list = AnimationConfig.EmoteList
	local name = list[((self._emoteIndex - 1) % #list) + 1]
	if self:PlayEmote(name) then
		return name
	end
	return nil
end

function AnimationSystem:Destroy()
	self._destroyed = true
	if self._hb then
		self._hb:Disconnect()
	end
	if self._stateConn then
		self._stateConn:Disconnect()
	end
	for _, t in self._tracks do
		t:Stop(0)
	end
	self._tracks = {}
end

return AnimationSystem
]]></ProtectedString>
					<string name="ScriptGuid">{AAE23318-7C47-49A0-93B1-D4E0147A5CCD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">AnimationSystem</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c90ee772e6884730aa3b29b000003f1</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="36">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Client aura body FX + emotes. Server owns shop trails (TrailService).

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local CosmeticsCatalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CosmeticsCatalog"))
local AuraTheme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AuraTheme"))

local CosmeticsSystem = {}
CosmeticsSystem.__index = CosmeticsSystem

local function makeAuraAttachment(hrp: BasePart): ParticleEmitter
	local att = hrp:FindFirstChild("AuraFarmAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "AuraFarmAtt"
		att.Parent = hrp
	end
	local pe = att:FindFirstChild("AuraParticles") :: ParticleEmitter?
	if pe then
		return pe
	end
	pe = Instance.new("ParticleEmitter")
	pe.Name = "AuraParticles"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(0.5, 1.0)
	pe.Speed = NumberRange.new(0.4, 1.6)
	pe.SpreadAngle = Vector2.new(40, 40)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Color = ColorSequence.new(AuraTheme.Colors.Accent, AuraTheme.Colors.AccentHot)
	pe.LightEmission = 0.7
	pe.LockedToPart = false
	pe.Parent = att
	return pe
end

function CosmeticsSystem.new(character: Model, humanoid: Humanoid, hrp: BasePart)
	local self = setmetatable({}, CosmeticsSystem)
	self.character = character
	self.humanoid = humanoid
	self.hrp = hrp
	self.emitter = makeAuraAttachment(hrp)
	self._trailId = "default"
	self._destroyed = false

	-- Soft aura point light
	local light = hrp:FindFirstChild("AuraBodyLight")
	if not light then
		light = Instance.new("PointLight")
		light.Name = "AuraBodyLight"
		light.Parent = hrp
	end
	light.Brightness = 0.6
	light.Range = 10
	light.Color = AuraTheme.Colors.Accent
	self.light = light

	return self
end

function CosmeticsSystem:SetTrailId(trailId: string?)
	self._trailId = trailId or "default"
	local def = CosmeticsCatalog.GetTrail(self._trailId) or CosmeticsCatalog.GetTrail("default")
	if def and self.emitter then
		self.emitter.Color = ColorSequence.new(def.color, def.color2 or def.color)
	end
	if def and self.light then
		self.light.Color = def.color
	end
end

function CosmeticsSystem:SetEnabled(on: boolean)
	if self.emitter then
		self.emitter.Enabled = on
	end
	if self.light then
		self.light.Enabled = on
	end
end

function CosmeticsSystem:PulseTrailColor(trailId: string?)
	local def = CosmeticsCatalog.GetTrail(trailId or self._trailId)
	if not def or not self.hrp then
		return
	end
	local highlight = self.character:FindFirstChild("AuraPulse")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "AuraPulse"
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0.3
		highlight.Parent = self.character
	end
	highlight.OutlineColor = def.color
	highlight.FillColor = def.color
	highlight.Enabled = true
	task.delay(0.45, function()
		if highlight and highlight.Parent then
			highlight.Enabled = false
		end
	end)
end

-- Cycle through catalog trails for local aura color (Y key in PlayerClient).
function CosmeticsSystem:CycleAura(): string
	local trails = CosmeticsCatalog.All()
	local list = {}
	for _, def in ipairs(trails) do
		if type(def) == "table" and def.id then
			table.insert(list, def.id)
		end
	end
	if #list == 0 then
		return self._trailId or "default"
	end
	local cur = self._trailId or "default"
	local idx = 1
	for i, id in ipairs(list) do
		if id == cur then
			idx = i
			break
		end
	end
	local nextId = list[(idx % #list) + 1]
	self:SetTrailId(nextId)
	self:PulseTrailColor(nextId)
	return nextId
end

function CosmeticsSystem:Destroy()
	self._destroyed = true
	if self.emitter then
		self.emitter.Enabled = false
	end
end

return CosmeticsSystem
]]></ProtectedString>
