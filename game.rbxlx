		priceAura = 220,
		color = Color3.fromRGB(80, 255, 230),
		color2 = Color3.fromRGB(255, 60, 140),
		lightEmission = 0.9,
		widthScale = 0.7,
		lifetime = 0.8,
		rarity = "Epic",
	},
	{
		id = "gold",
		name = "Gold Rush",
		description = "Show-off finish flex",
		priceAura = 300,
		color = Color3.fromRGB(255, 220, 80),
		color2 = Color3.fromRGB(255, 160, 40),
		lightEmission = 0.85,
		widthScale = 0.65,
		lifetime = 0.85,
		rarity = "Epic",
	},
	{
