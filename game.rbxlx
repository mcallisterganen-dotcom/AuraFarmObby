		priceAura = 100,
		color = Color3.fromRGB(255, 140, 60),
		color2 = Color3.fromRGB(255, 60, 40),
		lightEmission = 0.7,
		widthScale = 0.6,
		lifetime = 0.7,
		rarity = "Rare",
	},
	{
		id = "canyon",
		name = "Crystal Wake",
		description = "Stage 2 canyon shimmer",
		priceAura = 140,
		color = Color3.fromRGB(180, 140, 255),
		color2 = Color3.fromRGB(100, 60, 200),
		lightEmission = 0.75,
		widthScale = 0.6,
		lifetime = 0.75,
		rarity = "Rare",
	},
	{
		id = "ocean",
		name = "Tide Runner",
		description = "Cool blue flow",
		priceAura = 160,
		color = Color3.fromRGB(80, 180, 255),
		color2 = Color3.fromRGB(40, 100, 220),
		lightEmission = 0.6,
		widthScale = 0.55,
		lifetime = 0.7,
		rarity = "Rare",
	},
	{
		id = "neon",
		name = "Neon Pulse",
