		description = "Dark prestige trail",
		priceAura = 450,
		color = Color3.fromRGB(40, 20, 60),
		color2 = Color3.fromRGB(160, 80, 255),
		lightEmission = 0.95,
		widthScale = 0.8,
		lifetime = 1.0,
		rarity = "Legendary",
	},
	{
		id = "rainbow",
