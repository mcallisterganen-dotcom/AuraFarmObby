					<ProtectedString name="Source"><![CDATA[-- Trail / aura cosmetics. Buy with Aura; equip for a visible trail.

local CosmeticsCatalog = {}

export type TrailDef = {
	id: string,
	name: string,
	description: string,
	priceAura: number,
	color: Color3,
	color2: Color3?,
	lightEmission: number?,
